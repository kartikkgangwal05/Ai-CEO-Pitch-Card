# GEMINI_API_KEY: makes the cartoon portrait from the camera photo (and is the text fallback).
# Get one at https://aistudio.google.com/apikey . Image models may need billing enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: optional. When set, Claude writes the funny title, two-line intro and
# one-word stats (Gemini text is the fallback). Claude cannot generate images.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Optional: try this Gemini image model first (Google renames models often).
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# APP_URL: where this applet is hosted (injected by AI Studio).
APP_URL="MY_APP_URL"
