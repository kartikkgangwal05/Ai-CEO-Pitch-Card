# GEMINI_API_KEY: the only AI key. Paints the portraits and writes the card text.
# Get one at https://aistudio.google.com/apikey . Image models may need billing enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# IMAGE_ENGINE: how the portrait is made.
#   filter (default): Instagram-style filter on the real photo, in the browser (instant, free, keeps the likeness).
#   gemini: Gemini repaints the photo in the chosen style (needs billing enabled on the Google project).
# IMAGE_ENGINE="filter"

# Optional: try this Gemini image model first (Google renames models often).
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# APP_URL: where this applet is hosted (injected by AI Studio).
APP_URL="MY_APP_URL"
