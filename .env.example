# GEMINI_API_KEY: makes the cartoon portrait from the camera photo (and is the text fallback).
# Get one at https://aistudio.google.com/apikey . Image models may need billing enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: optional. When set, Claude writes the funny title, two-line intro and
# one-word stats (Gemini text is the fallback). Claude cannot generate images.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# IMAGE_ENGINE: how the portrait is made.
#   filter (default): Instagram-style filter on the real photo, in the browser (instant, free, keeps the likeness).
#   claude: Claude reads the photo and builds a vector cartoon
#          avatar (hair, glasses, beard, skin/hair colours) with the DiceBear avatar kits. Claude can't paint pixels.
#   gemini: Gemini repaints the photo in the chosen style (needs billing enabled on the Google project).
# IMAGE_ENGINE="filter"

# Optional: try this Gemini image model first (Google renames models often).
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# APP_URL: where this applet is hosted (injected by AI Studio).
APP_URL="MY_APP_URL"

# Cloudflare Workers AI (stream portraits): repaints the visitor in academy robes for their stream.
# Account ID: Cloudflare dashboard -> Workers & Pages (right sidebar) or the URL after dash.cloudflare.com/.
# API token: My Profile -> API Tokens -> Create Token -> "Workers AI" template (Account > Workers AI > Read).
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"
# Optional: CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-9b"
